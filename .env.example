# TigerGraph Connection Config
TIGERGRAPH_HOST=https://your-domain.i.tgcloud.io
TIGERGRAPH_GRAPH_NAME=FraudGraph
TIGERGRAPH_USERNAME=tigergraph
TIGERGRAPH_PASSWORD=your_password
TIGERGRAPH_SECRET=your_restpp_secret
TIGERGRAPH_API_TOKEN=

# Gateway Mode: "live" or "fixture" (default: fixture)
# When set to fixture, the system uses the high-fidelity offline graph engine
GRAPH_GATEWAY_MODE=fixture

# Agent & Service Config
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO
ENVIRONMENT=development

# Optional LLM API Key (for external reasoning synthesis)
# The system functions deterministically via GraphRAG even if unset
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
